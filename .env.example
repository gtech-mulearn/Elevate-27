# Environment variables for ELEVATE'27 — Trivandrum Edition
# All optional: the defaults in lib/sheets.ts already point at the ELEVATE'27 sheet.
# Set these only to switch to a different sheet or tab.

# Google Sheet (must be shared as "Anyone with the link can view")
# NEXT_PUBLIC_SHEET_ID=16zCivkxycg37rWt65a4aeR3b-Ku-vVbkWyCYLKTA-_4

# Tab GIDs inside that sheet (the gid=… part of each tab's URL)
#   Speakers tab headers: Name, Title, Company, Image, Linkedin
#   Partners tab headers: Logo Link (optional: Name, Website)
#   Status tab: a "Sold Out" header with TRUE/FALSE in row 2
# NEXT_PUBLIC_SPEAKERS_GID=168332648
# NEXT_PUBLIC_PARTNERS_GID=89538245
# NEXT_PUBLIC_SOLD_OUT_GID=2059209065

# Google Search Console verification (optional)
# GOOGLE_SITE_VERIFICATION=
